{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Platform": "Server=(localdb)\\MSSQLLocalDB;Database=Negosio_Platform;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=true"
  },
  "TenantDatabases": {
    "DefaultServerKey": "default",
    "Servers": {
      "default": "Server=(localdb)\\MSSQLLocalDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=true"
    }
  },
  "Jwt": {
    "Issuer": "negosio-api",
    "Audience": "negosio-web",
    "SigningKey": "dev-only-insecure-signing-key-change-me-32chars-min-000",
    "AccessTokenMinutes": 60
  },
  "Database": {
    "MigrateOnStartup": true
  }
}
