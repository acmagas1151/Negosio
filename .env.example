# Copy to .env and fill in real values. .env is git-ignored.

# ---- SQL Server (docker-compose) ----
MSSQL_SA_PASSWORD=Your_Strong_Passw0rd!
MSSQL_PORT=1433

# ---- Negosio.Api ----
# Database-per-tenant (Phase 2.5): a fixed platform (control-plane) database, plus a connection-string
# TEMPLATE (server + auth, no Database=) for the server that new tenant databases are provisioned onto.
ConnectionStrings__Platform=Server=localhost,1433;Database=Negosio_Platform;User Id=sa;Password=Your_Strong_Passw0rd!;TrustServerCertificate=true;MultipleActiveResultSets=true
TenantDatabases__DefaultServerKey=default
TenantDatabases__Servers__default=Server=localhost,1433;User Id=sa;Password=Your_Strong_Passw0rd!;TrustServerCertificate=true;MultipleActiveResultSets=true

# JWT signing configuration (do NOT commit real secrets)
Jwt__Issuer=negosio-api
Jwt__Audience=negosio-web
Jwt__SigningKey=replace-with-at-least-32-random-bytes-base64-or-hex
Jwt__AccessTokenMinutes=60

# Apply EF Core migrations automatically on API startup (handy for local/dev)
Database__MigrateOnStartup=true

# CORS origin for the web app
Cors__AllowedOrigins__0=http://localhost:5173

# ---- Web (negosio-web) ----
VITE_API_BASE_URL=http://localhost:5170
